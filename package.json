{
  "name": "my-next-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:worker": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "deploy": "pnpm build:worker && opennextjs-cloudflare deploy",
    "preview": "pnpm build:worker && opennextjs-cloudflare preview",
    "types": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts && wrangler types --config workers/counter/wrangler.jsonc --env-interface CounterEnv ./workers/counter/env.d.ts --include-runtime=false",
    "config": "node scripts/build-config.js",
    "deploy:counter": "wrangler deploy --config workers/counter/wrangler.jsonc",
    "dev:counter": "wrangler dev --config workers/counter/wrangler.jsonc",
    "test:analysis": "tsx --test tests/analysis.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/d1-adapter": "^1.11.1",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@opennextjs/cloudflare": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.7",
    "jose": "^6.2.2",
    "lucide-react": "^0.546.0",
    "next": "15.5.14",
    "next-auth": "5.0.0-beta.29",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "octokit": "^5.0.5",
    "opentype.js": "^1.3.4",
    "radix-ui": "latest",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "svgo": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20.19.37",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "miniflare": "5.20261102.0-beta",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.2"
  }
}
